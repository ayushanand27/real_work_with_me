<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Average_Rating__c</fullName>
    <description>Roll-up summaries cannot average, so this divides the SUM roll-up by the COUNT roll-up.</description>
    <formula>IF(Number_of_Reviews__c = 0, NULL, Total_Rating__c / Number_of_Reviews__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Average Rating</label>
    <precision>3</precision>
    <scale>1</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
</CustomField>
