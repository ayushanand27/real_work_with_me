<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Open__c</fullName>
    <description>Formula: days since the position opened.</description>
    <formula>IF(ISBLANK(Open_Date__c), NULL, TODAY() - Open_Date__c)</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Days Open</label>
    <precision>18</precision>
    <scale>0</scale>
    <trackTrending>false</trackTrending>
    <type>Number</type>
</CustomField>
