{
  "manifest_version": 3,
  "name": "CrossCheck: catch AI hallucinations",
  "short_name": "CrossCheck",
  "version": "0.1.0",
  "description": "Checks AI answers claim by claim across several models and verifies citations against real databases. Uses your own API keys.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open CrossCheck",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.crossref.org/*",
    "https://api.openalex.org/*",
    "https://export.arxiv.org/*",
    "https://doi.org/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
